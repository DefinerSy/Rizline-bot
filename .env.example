# Obtain these from the QQ Open Platform console. Never commit the real file.
QQ_APP_ID=replace-with-your-app-id
QQ_APP_SECRET=replace-with-your-app-secret

# Set to true only when testing against the QQ Open Platform sandbox.
QQ_IS_SANDBOX=false

# auto: use public DNS only when local DNS returns private addresses for QQ.
# Set to off on a normal network, or on to force the fallback.
QQ_DNS_FALLBACK=auto

# RizLine score lookup reads locally exported, already decrypted save files.
# Example: data/rizline_saves/default.json
RIZLINE_SAVE_DIR=data/rizline_saves
RIZLINE_DEFAULT_PLAYER=default

# Local chart metadata is refreshed manually with tools/update_rizline_catalog.py.
# Keep this path local; the bot never downloads song data while replying.
RIZLINE_SONG_CATALOG_PATH=data/rizline_song_catalog.json

# Optional directory containing a locally authorized rizline-assets-get output/ export.
# The bot reads artwork from it only; it never downloads game resources while replying.
# RIZLINE_ARTWORK_DIR=/secure/path/to/rizline-assets-get/output

# Local, permission-600 mapping of QQ OpenIDs to score snapshot aliases.
# While set, score queries require SMS login or a one-time-code binding. Set empty only to
# restore the older shared/default-player behavior.
RIZLINE_BINDING_DB=data/rizline_bindings.json
RIZLINE_QQ_LOGIN_ENABLED=true
RIZLINE_LOGIN_CHANNEL_ID=1

# /riz b40 writes a PNG here.
RIZLINE_IMAGE_OUTPUT_DIR=data/rizline_exports

# Option A: map the export directory to an HTTPS static server. Leave blank
# when using Tencent COS below.
# RIZLINE_IMAGE_PUBLIC_BASE_URL=https://bot.example.com/rizline-b40/

# Option B: private Tencent COS delivery (recommended: no self-hosted website).
# Create a private COS bucket and a least-privilege API key with PutObject and
# GetObject for only this prefix. QQ receives a short-lived signed HTTPS URL.
# Keep the real values only in .env, never in chat or source control.
# RIZLINE_COS_BUCKET=your-bucket-1250000000
# RIZLINE_COS_REGION=ap-guangzhou
# RIZLINE_COS_SECRET_ID=your-cos-secret-id
# RIZLINE_COS_SECRET_KEY=your-cos-secret-key
# RIZLINE_COS_PREFIX=qq-rizline-b40
# RIZLINE_COS_URL_EXPIRES_SECONDS=600
# Optional only for temporary STS credentials:
# RIZLINE_COS_SESSION_TOKEN=

# Optional: change the log verbosity (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Encrypted player credentials and a separately stored, auto-generated master key.
# Do not put either path in the image export directory or upload them to COS.
RIZLINE_TOKEN_DB=data/rizline_tokens.sqlite3
RIZLINE_TOKEN_KEY_FILE=.secrets/rizline-token.key
